<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneBigCity_Core\OneBigCity_Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Settaggi.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settaggi.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settaggi.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settaggi.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
